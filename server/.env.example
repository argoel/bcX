# ── Jack Henry Consumer API (Banno) ────────────────────────────────
# Get credentials from External Application config in Banno People
# Garden Bank sandbox: digital.garden-fi.com
JH_CONSUMER_ENV=digital.garden-fi.com
JH_CONSUMER_CLIENT_ID=your-client-id
JH_CONSUMER_CLIENT_SECRET=your-client-secret
JH_CONSUMER_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ── jXchange SOAP API ─────────────────────────────────────────────
# Service gateway URL provided during JH onboarding
JH_JXCHANGE_GATEWAY_URL=https://jxchange.jackhenry.com/jxchange/2008/ServiceGateway.svc
JH_JXCHANGE_TOKEN_URL=https://auth.jackhenry.com/oauth2/token
JH_JXCHANGE_CLIENT_ID=your-jxchange-client-id
JH_JXCHANGE_CLIENT_SECRET=your-jxchange-client-secret

# Institution identification
JH_INST_ROUTING_ID=your-institution-routing-number
JH_INST_ENV=PROD
JH_CONSUMER_NAME=FinanceHub
JH_CONSUMER_PRODUCT=BillPay

# ── Enterprise Event System (EES) ─────────────────────────────────
JH_EES_SERVICE_URL=https://ees.jackhenry.com/EES/Service.svc
JH_EES_SUBSCRIBER_URL=https://your-domain.com/api/ees/events

# ── Server ────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
