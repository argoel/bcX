# myPay environment configuration.
# Copy to `.env.local` (which is git-ignored) and fill in real values.

# ---------------------------------------------------------------
# Root client mode
# ---------------------------------------------------------------
# "true"  → fully client-side mock, no network calls.  Default.
# "false" → real calls to /api/root/*, which Vite proxies to
#           ROOT_SANDBOX_BASE_URL with the secret key injected.
VITE_USE_MOCK_ROOT=true

# ---------------------------------------------------------------
# Root sandbox credentials (SERVER-SIDE ONLY — never VITE_ prefixed!)
# ---------------------------------------------------------------
# These are only used when VITE_USE_MOCK_ROOT=false.  They live in the
# Vite dev-server process (or your prod backend) and are injected into
# the Authorization header of proxied requests.  The browser never sees
# them.
ROOT_SANDBOX_API_KEY=root_sk_sandbox_xxxxxxxxxxxxxxxx
ROOT_SANDBOX_BASE_URL=https://sandbox.api.useroot.com
